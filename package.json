{
  "name": "@ferris1225/pi-droid-ui",
  "version": "1.0.0",
  "description": "Combined Pi layout and theme pack: sting8k droid styling plus pi-themes, bundled as one extension.",
  "type": "module",
  "main": "dist/index.js",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MCapricorns/pi-droid-ui.git"
  },
  "homepage": "https://github.com/MCapricorns/pi-droid-ui#readme",
  "bugs": {
    "url": "https://github.com/MCapricorns/pi-droid-ui/issues"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi-themes",
    "pi-droid-styling",
    "pi-coding-agent"
  ],
  "files": [
    "dist",
    "themes",
    "README.md",
    "LICENSE",
    "NOTICE.md",
    "screenshots"
  ],
  "pi": {
    "extensions": [
      "./dist/index.js"
    ],
    "themes": [
      "./themes"
    ],
    "image": "https://raw.githubusercontent.com/MCapricorns/pi-droid-ui/main/screenshots/image.png"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit --module NodeNext --moduleResolution NodeNext --target ES2022 --skipLibCheck --noImplicitAny false index.ts",
    "test": "npm run test:working-message && npm run test:startup-resources && npm run test:theme-extras && npm run test:themes-pack && npm run test:user-zone-style && npm run test:nvim-user-zone && npm run test:core-message-blocks && npm run test:tasks-widget-compact && npm run test:reasonix-conversation && npm run test:session-resume-styling && npm run test:tui-proxy",
    "check": "npm run typecheck && npm test && npm run build && npm pack --dry-run",
    "prepublishOnly": "npm run check",
    "profile:render": "node scripts/render-profile-bench.mjs",
    "trace:pi": "node scripts/pi-trace.mjs",
    "debug:render-log": "node scripts/render-frame-log-summary.mjs",
    "test:working-message": "node scripts/working-message-config-smoke.mjs",
    "test:startup-resources": "node scripts/startup-resources-smoke.mjs",
    "test:theme-extras": "node scripts/theme-extras-smoke.mjs",
    "test:themes-pack": "node scripts/themes-pack-smoke.mjs",
    "test:user-zone-style": "node scripts/user-zone-style-smoke.mjs",
    "test:nvim-user-zone": "node scripts/nvim-user-zone-smoke.mjs",
    "test:core-message-blocks": "node scripts/core-message-blocks-smoke.mjs",
    "test:tasks-widget-compact": "node scripts/tasks-widget-compact-smoke.mjs",
    "test:reasonix-conversation": "node scripts/reasonix-conversation-smoke.mjs",
    "test:session-resume-styling": "node scripts/session-resume-styling-smoke.mjs",
    "test:tui-proxy": "node scripts/tui-proxy-recursion-smoke.mjs"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=0.78.0 <1.0.0",
    "@earendil-works/pi-tui": ">=0.78.0 <1.0.0"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.84.4",
    "@earendil-works/pi-tui": "^0.84.4",
    "esbuild": "^0.25.12",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "@google/genai": false,
    "protobufjs": false
  }
}
